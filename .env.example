# Banco de imagens Pexels (criativos, follow-ups, landing pages). Fica só no servidor.
PEXELS_API_KEY=

# Solicitações de design → planilha RAR, e-mail e agenda (ver integrations/google-apps-script/README.md)
TICKETS_WEBHOOK_URL=
TICKETS_WEBHOOK_TOKEN=
TICKETS_INBOX=mkt@gove.digital

# Acesso só pela VPN Gove (Pritunl gove-ecs): faixas CIDR da VPN, separadas por vírgula
ALLOWED_NETWORKS=
# Atrás de proxy/balanceador: número de saltos confiáveis ou "true"
TRUST_PROXY=

# Conector "Pexels Gove" para o claude.ai: endereço https://<servidor>/mcp/<PEXELS_MCP_TOKEN>
# (token longo e aleatório; nunca no git). Usa a mesma PEXELS_API_KEY.
PEXELS_MCP_TOKEN=
# Captura de sites (Print Studio, Portal Cidadão): Chromium do sistema, se não usar o do Playwright
# (npx playwright@1.56.1 install --with-deps chromium)
CHROMIUM_PATH=
