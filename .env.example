# Banco de imagens Pexels (criativos, follow-ups, landing pages). Fica só no servidor.
PEXELS_API_KEY=

# Solicitações de design → planilha RAR, e-mail e agenda (ver integrations/google-apps-script/README.md)
TICKETS_WEBHOOK_URL=
TICKETS_WEBHOOK_TOKEN=
TICKETS_INBOX=larissa.andrade@gove.digital

# Acesso só pela VPN Gove (Pritunl gove-ecs): faixas CIDR da VPN, separadas por vírgula
ALLOWED_NETWORKS=
# Atrás de proxy/balanceador: número de saltos confiáveis ou "true"
TRUST_PROXY=

# Conector "Pexels Gove" para o claude.ai: endereço https://<servidor>/mcp/<PEXELS_MCP_TOKEN>
# (token longo e aleatório; nunca no git). Usa a mesma PEXELS_API_KEY.
PEXELS_MCP_TOKEN=
# Captura de sites (Print Studio, Portal Cidadão): Chromium do sistema, se não usar o do Playwright
# (npx playwright@1.56.1 install --with-deps chromium)
CHROMIUM_PATH=

# Conector "Gove Grafana" para o claude.ai (ver integrations/grafana-connector/README.md).
# Cada pessoa entra com o usuário e a senha do próprio Grafana; nada disso vai para o git.
# Endereço interno do Grafana (alcançável a partir deste servidor, dentro da VPN)
GRAFANA_URL=
# Segredo longo e aleatório (mín. 32 caracteres; ex.: openssl rand -hex 32). Trocar derruba as conexões.
GRAFANA_CONNECTOR_SECRET=
# Endereço público deste servidor (sem barra no fim), ex.: https://design.gove.digital
PUBLIC_BASE_URL=
# redirect_uri aceitos (comparação exata), separados por vírgula. Vazio = os do claude.ai:
# https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
GRAFANA_CONNECTOR_REDIRECTS=
# Tag dos dashboards de cases no Grafana (padrão: cases)
GRAFANA_CASES_TAG=cases
# Nome do cookie de sessão do Grafana (padrão: grafana_session; muda só se o Grafana usar outro)
GRAFANA_SESSION_COOKIE=
