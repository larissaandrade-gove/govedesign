{
  "name": "gove-revisor-identidade",
  "version": "0.1.0",
  "description": "Revisor de identidade visual para peças de marketing e apresentações da Gove Digital",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "db:init": "node db/init.js",
    "test": "node --test test/*.test.js",
    "criativos:install": "npm --prefix criativos install",
    "criativos:dev": "npm --prefix criativos run dev -- --port 5173",
    "criativos:build": "npm --prefix criativos run build",
    "links:install": "npm --prefix links install",
    "links:dev": "npm --prefix links run dev -- --port 5174",
    "links:build": "npm --prefix links run build",
    "lp:install": "npm --prefix lp-builder install",
    "lp:dev": "npm --prefix lp-builder run dev -- --port 5175",
    "lp:build": "npm --prefix lp-builder run build",
    "print:install": "cd print-studio/web && pnpm install",
    "print:build": "cd print-studio/web && pnpm run bundle",
    "print:icons": "node print-studio/scripts/build-icons.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larissaandrade-gove/govedesign.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/larissaandrade-gove/govedesign/issues"
  },
  "homepage": "https://github.com/larissaandrade-gove/govedesign#readme",
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "fabric": "^7.4.0",
    "lucide": "^1.48.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "private": true
}
